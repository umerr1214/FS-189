# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# HuggingFace Local Models
HF_MODEL_NAME=meta-llama/Llama-3.2-3B-Instruct
QWEN_MODEL_NAME=Qwen/Qwen2.5-Coder-7B-Instruct
QWEN_MAX_NEW_TOKENS=2048
# Path to a fine-tuned LoRA adapter (relative to autograder-ai/). Leave blank to use the base model.
QWEN_ADAPTER_PATH=./fine_tuned_adapter
